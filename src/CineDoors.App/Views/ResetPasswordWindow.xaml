<Window x:Class="CineDoors.App.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mot de passe oublié"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <!-- Sans barre de titre Windows : la carte arrondie est toute la fenêtre.
         MouseLeftButtonDown permet de la déplacer en la tenant à la souris. -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="32,26,32,30" MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel>

            <!-- Titre et bouton de fermeture -->
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource InputIconButton}" Content="&#xE8BB;"
                        FontSize="11" Click="CloseButton_Click" />
                <TextBlock Text="MOT DE PASSE OUBLIÉ" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
            </DockPanel>

            <!-- Avertissement -->
            <TextBlock Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Cette fonctionnalité est encore en développement : l'envoi d'un e-mail de vérification n'est pas disponible. En attendant, vous pouvez réinitialiser votre mot de passe directement ci-dessous." />

            <!-- Pseudo -->
            <Border Style="{StaticResource InputFrame}" Margin="0,22,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource InputIcon}" Text="&#xE77B;" />
                    <Grid>
                        <TextBlock x:Name="UsernamePlaceholder" Style="{StaticResource InputPlaceholder}" Text="Pseudo" />
                        <TextBox x:Name="UsernameBox" Style="{StaticResource InputText}" TextChanged="UsernameBox_TextChanged" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Nouveau mot de passe -->
            <Border Style="{StaticResource InputFrame}" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource InputIcon}" Text="&#xE72E;" />
                    <Grid>
                        <TextBlock x:Name="NewPasswordPlaceholder" Style="{StaticResource InputPlaceholder}" Text="Nouveau mot de passe" />
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource InputPassword}" PasswordChanged="NewPasswordBox_PasswordChanged" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Message : erreur en rouge, ou confirmation en vert -->
            <TextBlock x:Name="MessageText" Foreground="{StaticResource ErrorBrush}" FontSize="13"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" />

            <Button x:Name="ResetButton" Style="{StaticResource PrimaryButton}" Content="Réinitialiser" Margin="0,14,0,0"
                    IsDefault="True" Click="ResetButton_Click" />
        </StackPanel>
    </Border>
</Window>